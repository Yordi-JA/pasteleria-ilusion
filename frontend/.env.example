# Copia este archivo a .env.local y llena los valores. .env.local no se versiona.
# Toda variable VITE_* termina en el código que se publica: aquí solo van llaves públicas.

# ID de cliente de OAuth de Google (termina en .apps.googleusercontent.com), el mismo
# que GOOGLE_CLIENT_ID del backend. Vacía: el botón de Google no aparece y se entra
# con el correo. En Heroku se define como variable de la app: el build la lee.
VITE_GOOGLE_CLIENT_ID=
