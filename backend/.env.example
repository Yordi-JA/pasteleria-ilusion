# Copia este archivo a .env y llena los valores. .env no se versiona.
# Aquí solo van los nombres de las variables, nunca valores reales.

# --- Django (obligatorias: la app no arranca sin ellas) ---
SECRET_KEY=
# Hosts separados por comas, por ejemplo: localhost,127.0.0.1
ALLOWED_HOSTS=

# --- Django (opcionales) ---
# True solo en desarrollo: tu .env local lleva DEBUG=True. Si falta, es False
# (producción) y entonces se exigen HTTPS, HSTS y cookies Secure.
DEBUG=
# Orígenes del frontend separados por comas (con esquema). Se usan para CORS y
# para CSRF_TRUSTED_ORIGINS. En desarrollo, por ejemplo http://localhost:5173.
# En producción el frontend y la API comparten origen (D15): deja la lista
# vacía. Con DEBUG apagado, un origen que no empiece con https:// impide
# arrancar.
CORS_ALLOWED_ORIGINS=
# Número de proxies de confianza delante de la app, para el throttling de DRF
# (identifica al cliente por X-Forwarded-For). OBLIGATORIO con DEBUG apagado;
# con DEBUG=True, si falta, es 0. En desarrollo, 0 (sin proxy); en Heroku, 1.
# Si no coincide con la realidad, el límite se puede evadir o se aplica a todos
# los clientes como si fueran uno. No puede ser negativo.
NUM_PROXIES=0
# Solo con DEBUG apagado. Si faltan, son False. Activa HSTS también en todos
# los subdominios y la lista de precarga de los navegadores (difícil de
# revertir): hazlo solo cuando todo el dominio sirva HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
# Dominio principal del sitio, sin esquema, puerto ni ruta. Con valor, `www.` +
# este dominio redirige con 301 a él, y al arrancar se valida que ALLOWED_HOSTS
# permita el dominio y su variante con www (sin ellos la app no arranca). Vacía
# o ausente, no hay redirección (desarrollo).
CANONICAL_HOST=

# --- Base de datos ---
# URL completa. En Heroku la aporta la plataforma.
DATABASE_URL=

# --- Contenedor de PostgreSQL de desarrollo (compose.yaml) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Puerto en 127.0.0.1; si falta, 5433 (el 5432 suele estar ocupado).
POSTGRES_PORT=
# Opcional. Nombre de la base de pruebas; si falta, es test_<POSTGRES_DB>. Útil
# con una segunda carpeta de trabajo sobre la misma PostgreSQL (D65). Por ejemplo:
# POSTGRES_TEST_DB=test_pasteleria_ilusion_otra_rama

# --- Bloqueo del inicio de sesión del admin (django-axes) ---
# Intentos fallidos antes de bloquear y minutos de bloqueo. Opcionales: si
# faltan, son 5 y 60. Quita el comentario para cambiarlos; deben ser enteros de al menos 1.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=60

# --- Acceso de clientes (D62) ---
# Llave para firmar los JWT, aleatoria, de 50 caracteres o más y distinta de
# SECRET_KEY (python -c "import secrets; print(secrets.token_urlsafe(50))").
# OBLIGATORIA con DEBUG apagado; en desarrollo, si falta, se usa SECRET_KEY.
# Cambiarla cierra todas las sesiones de clientes.
JWT_SIGNING_KEY=
# ID de cliente de OAuth de Google (termina en .apps.googleusercontent.com). Es
# público y debe ser el mismo que VITE_GOOGLE_CLIENT_ID del frontend. Vacía: el
# acceso con Google responde 503 y el sitio sigue con el correo. Nunca pongas
# aquí el client secret: el acceso con Google Identity Services no lo usa.
GOOGLE_CLIENT_ID=

# --- Pagos en sandbox (D68) ---
# Llaves secretas: nunca van al frontend (ahí solo va la llave pública de Stripe,
# pk_..., como VITE_STRIPE_PUBLISHABLE_KEY). Cada método necesita las dos de su
# pasarela; si falta una, ese método responde 503 y los demás siguen funcionando.
# Mercado Pago: el Access Token de prueba (Tus integraciones > Credenciales) y la
# clave secreta de Webhooks (Tus integraciones > Webhooks > Clave secreta). El
# webhook se configura con la URL https://<dominio>/api/v1/payments/webhooks/mercadopago/
# y el evento "Pagos".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Stripe: la llave secreta de prueba (sk_test_...) y el secreto de firma del
# endpoint (whsec_...), con la URL https://<dominio>/api/v1/payments/webhooks/stripe/
# y los eventos payment_intent.succeeded y payment_intent.payment_failed.
# STRIPE_SECRET_KEY solo acepta llaves de prueba (sk_test_ o rk_test_): con una
# real (sk_live_ o rk_live_) la app no arranca.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Correo (D70) ---
# SMTP de cualquier proveedor (por ejemplo Brevo o Gmail); el código no se ata a
# ninguno. Vacía EMAIL_HOST: en desarrollo (DEBUG=True) los correos salen en la
# consola; en producción no se envía nada y queda un aviso INFO en el registro.
# Con EMAIL_HOST, DEFAULT_FROM_EMAIL es obligatorio.
EMAIL_HOST=
# Opcional; si falta, 587 (STARTTLS). Quita el comentario para cambiarlo.
# EMAIL_PORT=587
EMAIL_HOST_USER=
# Secreta: la contraseña o llave SMTP del proveedor. Nunca la pongas en el repositorio.
EMAIL_HOST_PASSWORD=
# Opcional; si falta, True.
# EMAIL_USE_TLS=True
# Remitente, por ejemplo "Pastelería Ilusión <pedidos@dominio>".
DEFAULT_FROM_EMAIL=
# Opcional: segundos de espera del SMTP; si falta, 5. Corto: el correo sale en la misma petición.
# EMAIL_TIMEOUT=5
