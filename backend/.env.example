# Copia este archivo a .env y llena los valores. .env no se versiona.
# Aquí solo van los nombres de las variables, nunca valores reales.

# --- Django (obligatorias: la app no arranca sin ellas) ---
SECRET_KEY=
# Hosts separados por comas, por ejemplo: localhost,127.0.0.1
ALLOWED_HOSTS=

# --- Django (opcionales) ---
# True solo en desarrollo: tu .env local lleva DEBUG=True. Si falta, es False
# (producción) y entonces se exigen HTTPS, HSTS y cookies Secure.
DEBUG=
# Orígenes del frontend separados por comas (con esquema). Se usan para CORS y
# para CSRF_TRUSTED_ORIGINS. En desarrollo, por ejemplo http://localhost:5173.
# En producción el frontend y la API comparten origen (D15): deja la lista
# vacía. Con DEBUG apagado, un origen que no empiece con https:// impide
# arrancar.
CORS_ALLOWED_ORIGINS=
# Número de proxies de confianza delante de la app, para el throttling de DRF
# (identifica al cliente por X-Forwarded-For). OBLIGATORIO con DEBUG apagado;
# con DEBUG=True, si falta, es 0. En desarrollo, 0 (sin proxy); en Heroku, 1.
# Si no coincide con la realidad, el límite se puede evadir o se aplica a todos
# los clientes como si fueran uno. No puede ser negativo.
NUM_PROXIES=0
# Solo con DEBUG apagado. Si faltan, son False. Activa HSTS también en todos
# los subdominios y la lista de precarga de los navegadores (difícil de
# revertir): hazlo solo cuando todo el dominio sirva HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
# Dominio principal del sitio, sin esquema, puerto ni ruta. Con valor, `www.` +
# este dominio redirige con 301 a él, y al arrancar se valida que ALLOWED_HOSTS
# permita el dominio y su variante con www (sin ellos la app no arranca). Vacía
# o ausente, no hay redirección (desarrollo).
CANONICAL_HOST=

# --- Base de datos ---
# URL completa. En Heroku la aporta la plataforma.
DATABASE_URL=

# --- Contenedor de PostgreSQL de desarrollo (compose.yaml) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Puerto en 127.0.0.1; si falta, 5433 (el 5432 suele estar ocupado).
POSTGRES_PORT=

# --- Bloqueo del inicio de sesión del admin (django-axes) ---
# Intentos fallidos antes de bloquear y minutos de bloqueo. Opcionales: si
# faltan, son 5 y 60. Quita el comentario para cambiarlos; deben ser enteros de al menos 1.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=60
